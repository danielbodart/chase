@@ -0,0 +1,264 @@
+// Package fakekey lets a sandbox hold a Google service account key file whose
+// private key is fake: generated per session, its public half given to
+// frisket. SPIKE.
+//
+// The key signs two things. An assertion to the token endpoint, which frisket
+// answers itself with the route's placeholder. And a self-signed JWT used
+// directly as a bearer, which the route treats as its placeholder.
+package fakekey
+
+import (
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	jwtBearer = "urn:ietf:params:oauth:grant-type:jwt-bearer"
+	skew      = 5 * time.Minute
+	// A self-signed JWT lives an hour; anything longer is not one.
+	maxLife = time.Hour + skew
+)
+
+type Key struct {
+	Email       string
+	TokenURI    string
+	Placeholder string
+	Log         *slog.Logger
+	Now         func() time.Time
+
+	pub  *rsa.PublicKey
+	mu   sync.Mutex
+	seen map[string]time.Time
+}
+
+func Load(path, email, tokenURI string, log *slog.Logger) (*Key, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	blk, _ := pem.Decode(b)
+	if blk == nil {
+		return nil, fmt.Errorf("%s: no PEM", path)
+	}
+	var pub any
+	switch blk.Type {
+	case "PUBLIC KEY":
+		pub, err = x509.ParsePKIXPublicKey(blk.Bytes)
+	case "CERTIFICATE":
+		var c *x509.Certificate
+		if c, err = x509.ParseCertificate(blk.Bytes); err == nil {
+			pub = c.PublicKey
+		}
+	default:
+		err = fmt.Errorf("PEM %q: a PUBLIC KEY or CERTIFICATE", blk.Type)
+	}
+	if err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	rk, ok := pub.(*rsa.PublicKey)
+	if !ok {
+		return nil, fmt.Errorf("%s: not an RSA key", path)
+	}
+	return &Key{Email: email, TokenURI: tokenURI, Log: log, Now: time.Now, pub: rk, seen: map[string]time.Time{}}, nil
+}
+
+type claims struct {
+	Iss            string          `json:"iss"`
+	Sub            string          `json:"sub"`
+	Aud            json.RawMessage `json:"aud"`
+	Scope          string          `json:"scope"`
+	TargetAudience string          `json:"target_audience"`
+	Iat            int64           `json:"iat"`
+	Exp            int64           `json:"exp"`
+}
+
+type header struct {
+	Alg string `json:"alg"`
+	Kid string `json:"kid"`
+}
+
+func (c claims) aud() string {
+	var s string
+	if json.Unmarshal(c.Aud, &s) == nil {
+		return s
+	}
+	var ss []string
+	if json.Unmarshal(c.Aud, &ss) == nil && len(ss) == 1 {
+		return ss[0]
+	}
+	return ""
+}
+
+// verify checks tok's RS256 signature against the key, then that it is the
+// service account's and in date.
+func (k *Key) verify(tok string) (header, claims, error) {
+	var h header
+	var c claims
+	parts := strings.Split(tok, ".")
+	if len(parts) != 3 {
+		return h, c, errors.New("not a JWT")
+	}
+	hb, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil || json.Unmarshal(hb, &h) != nil || h.Alg != "RS256" {
+		return h, c, errors.New("header: not RS256")
+	}
+	sig, err := base64.RawURLEncoding.DecodeString(parts[2])
+	if err != nil {
+		return h, c, errors.New("signature: not base64url")
+	}
+	sum := sha256.Sum256([]byte(parts[0] + "." + parts[1]))
+	if rsa.VerifyPKCS1v15(k.pub, crypto.SHA256, sum[:], sig) != nil {
+		return h, c, errors.New("signature does not verify")
+	}
+	cb, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil || json.Unmarshal(cb, &c) != nil {
+		return h, c, errors.New("claims: not JSON")
+	}
+	now := k.Now()
+	exp, iat := time.Unix(c.Exp, 0), time.Unix(c.Iat, 0)
+	switch {
+	case c.Iss != k.Email:
+		return h, c, fmt.Errorf("iss %q", c.Iss)
+	case c.Sub != "" && c.Sub != k.Email:
+		return h, c, fmt.Errorf("sub %q", c.Sub)
+	case !now.Before(exp):
+		return h, c, errors.New("expired")
+	case iat.After(now.Add(skew)) || exp.Sub(iat) > maxLife:
+		return h, c, errors.New("iat/exp out of range")
+	}
+	return h, c, nil
+}
+
+func short(tok string) string {
+	s := sha256.Sum256([]byte(tok))
+	return hex.EncodeToString(s[:4])
+}
+
+// Bearer is whether tok, a bearer sent to host, is a self-signed JWT of the
+// fake key's: the route's placeholder. Verified once per JWT.
+func (k *Key) Bearer(tok, host string) bool {
+	if strings.Count(tok, ".") != 2 || !strings.HasPrefix(tok, "eyJ") {
+		return false
+	}
+	now := k.Now()
+	k.mu.Lock()
+	exp, ok := k.seen[tok]
+	k.mu.Unlock()
+	if ok && now.Before(exp) {
+		k.Log.Debug("service account jwt", "jwt", short(tok), "host", host, "cached", true)
+		return true
+	}
+	h, c, err := k.verify(tok)
+	if err == nil {
+		aud := c.aud()
+		switch {
+		case aud == "https://"+host+"/":
+		case aud == "" && c.Scope != "":
+		default:
+			err = fmt.Errorf("aud %q for host %s", aud, host)
+		}
+	}
+	if err != nil {
+		k.Log.Info("service account jwt refused", "jwt", short(tok), "host", host, "error", err.Error())
+		return false
+	}
+	k.Log.Info("service account jwt", "jwt", short(tok), "host", host, "cached", false,
+		"kid", h.Kid, "aud", c.aud(), "scope", c.Scope, "iat", c.Iat, "exp", c.Exp, "life", c.Exp-c.Iat)
+	k.mu.Lock()
+	if len(k.seen) > 4096 {
+		for t, e := range k.seen {
+			if !now.Before(e) {
+				delete(k.seen, t)
+			}
+		}
+	}
+	k.seen[tok] = time.Unix(c.Exp, 0)
+	k.mu.Unlock()
+	return true
+}
+
+// TokenEndpoint answers the jwt-bearer grant for an assertion the fake key
+// signed: the placeholder as the access token, or a JWT-shaped placeholder
+// as the ID token. Anything else is invalid_grant; nothing goes to Google.
+func (k *Key) TokenEndpoint() http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json; charset=utf-8")
+		w.Header().Set("Cache-Control", "no-store")
+		fail := func(why string) {
+			k.Log.Info("token endpoint refused", "path", r.URL.Path, "error", why)
+			w.WriteHeader(http.StatusBadRequest)
+			_ = json.NewEncoder(w).Encode(map[string]string{"error": "invalid_grant", "error_description": "frisket: " + why})
+		}
+		if r.Method != http.MethodPost {
+			fail("not POST")
+			return
+		}
+		r.Body = http.MaxBytesReader(w, r.Body, 64<<10)
+		if err := r.ParseForm(); err != nil {
+			fail("form")
+			return
+		}
+		if g := r.PostForm.Get("grant_type"); g != jwtBearer {
+			fail("grant_type " + g)
+			return
+		}
+		h, c, err := k.verify(r.PostForm.Get("assertion"))
+		if err == nil && c.aud() != k.TokenURI && c.aud() != legacyTokenURI {
+			err = fmt.Errorf("aud %q", c.aud())
+		}
+		if err != nil {
+			fail(err.Error())
+			return
+		}
+		k.Log.Info("token endpoint", "kid", h.Kid, "scope", c.Scope, "target_audience", c.TargetAudience,
+			"life", c.Exp-c.Iat)
+		if c.TargetAudience != "" {
+			_ = json.NewEncoder(w).Encode(map[string]string{"id_token": k.idToken(c.TargetAudience)})
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": k.Placeholder,
+			"expires_in":   3599,
+			"token_type":   "Bearer",
+		})
+	})
+}
+
+const legacyTokenURI = "https://www.googleapis.com/oauth2/v4/token"
+
+// LegacyTokenEndpoint is TokenEndpoint at www.googleapis.com/oauth2/v4/token,
+// where gtoken sends its assertion whatever the key file's token_uri says.
+func (k *Key) LegacyTokenEndpoint(host, path string) http.Handler {
+	if "https://"+host+path != legacyTokenURI {
+		return nil
+	}
+	return k.TokenEndpoint()
+}
+
+// idToken is shaped like Google's, so a client can read its expiry, and
+// signed by nobody.
+func (k *Key) idToken(aud string) string {
+	now := k.Now().Unix()
+	enc := func(v any) string {
+		b, _ := json.Marshal(v)
+		return base64.RawURLEncoding.EncodeToString(b)
+	}
+	return enc(map[string]string{"alg": "RS256", "typ": "JWT", "kid": "frisket-placeholder"}) + "." +
+		enc(map[string]any{"iss": "https://accounts.google.com", "aud": aud, "azp": k.Email, "sub": k.Email,
+			"email": k.Email, "email_verified": true, "iat": now, "exp": now + 3600}) + "." +
+		base64.RawURLEncoding.EncodeToString([]byte(k.Placeholder))
+}
