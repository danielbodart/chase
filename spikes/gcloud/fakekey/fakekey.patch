+++ b/internal/fakekey/fakekey_test.go
@@ -0,0 +1,130 @@
+package fakekey
+
+import (
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+const email = "sa@p.iam.gserviceaccount.com"
+const tokenURI = "https://oauth2.googleapis.com/token"
+
+func setup(t testing.TB) (*Key, *rsa.PrivateKey) {
+	priv, _ := rsa.GenerateKey(rand.Reader, 2048)
+	der, _ := x509.MarshalPKIXPublicKey(&priv.PublicKey)
+	p := filepath.Join(t.TempDir(), "pub.pem")
+	os.WriteFile(p, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der}), 0o600)
+	k, err := Load(p, email, tokenURI, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	k.Placeholder = "proxy-injected"
+	return k, priv
+}
+
+func sign(priv *rsa.PrivateKey, c map[string]any) string {
+	enc := func(v any) string { b, _ := json.Marshal(v); return base64.RawURLEncoding.EncodeToString(b) }
+	in := enc(map[string]string{"alg": "RS256", "typ": "JWT", "kid": "k1"}) + "." + enc(c)
+	sum := sha256.Sum256([]byte(in))
+	sig, _ := rsa.SignPKCS1v15(rand.Reader, priv, crypto.SHA256, sum[:])
+	return in + "." + base64.RawURLEncoding.EncodeToString(sig)
+}
+
+func TestBearer(t *testing.T) {
+	k, priv := setup(t)
+	other, _ := rsa.GenerateKey(rand.Reader, 2048)
+	now := time.Now().Unix()
+	ok := map[string]any{"iss": email, "sub": email, "aud": "https://storage.googleapis.com/", "iat": now, "exp": now + 3600}
+	scoped := map[string]any{"iss": email, "sub": email, "scope": "https://www.googleapis.com/auth/cloud-platform", "iat": now, "exp": now + 3600}
+	for _, c := range []struct {
+		name string
+		tok  string
+		want bool
+	}{
+		{"aud host", sign(priv, ok), true},
+		{"scope", sign(priv, scoped), true},
+		{"other key", sign(other, ok), false},
+		{"other host", sign(priv, map[string]any{"iss": email, "aud": "https://pubsub.googleapis.com/", "iat": now, "exp": now + 3600}), false},
+		{"other iss", sign(priv, map[string]any{"iss": "x@y", "aud": "https://storage.googleapis.com/", "iat": now, "exp": now + 3600}), false},
+		{"expired", sign(priv, map[string]any{"iss": email, "aud": "https://storage.googleapis.com/", "iat": now - 7200, "exp": now - 3600}), false},
+		{"long", sign(priv, map[string]any{"iss": email, "aud": "https://storage.googleapis.com/", "iat": now, "exp": now + 86400}), false},
+		{"token aud", sign(priv, map[string]any{"iss": email, "aud": tokenURI, "iat": now, "exp": now + 3600}), false},
+		{"placeholder", "proxy-injected", false},
+	} {
+		if got := k.Bearer(c.tok, "storage.googleapis.com"); got != c.want {
+			t.Errorf("%s: %v", c.name, got)
+		}
+	}
+}
+
+func TestTokenEndpoint(t *testing.T) {
+	k, priv := setup(t)
+	now := time.Now().Unix()
+	post := func(form url.Values) (int, map[string]any) {
+		w := httptest.NewRecorder()
+		r := httptest.NewRequest(http.MethodPost, "/token", strings.NewReader(form.Encode()))
+		r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		k.TokenEndpoint().ServeHTTP(w, r)
+		var m map[string]any
+		json.Unmarshal(w.Body.Bytes(), &m)
+		return w.Code, m
+	}
+	code, m := post(url.Values{"grant_type": {jwtBearer}, "assertion": {sign(priv, map[string]any{"iss": email, "aud": tokenURI, "scope": "s", "iat": now, "exp": now + 3600})}})
+	if code != 200 || m["access_token"] != "proxy-injected" {
+		t.Fatal(code, m)
+	}
+	code, m = post(url.Values{"grant_type": {jwtBearer}, "assertion": {sign(priv, map[string]any{"iss": email, "aud": tokenURI, "target_audience": "https://x", "iat": now, "exp": now + 3600})}})
+	if code != 200 || strings.Count(m["id_token"].(string), ".") != 2 {
+		t.Fatal(code, m)
+	}
+	other, _ := rsa.GenerateKey(rand.Reader, 2048)
+	for _, f := range []url.Values{
+		{"grant_type": {jwtBearer}, "assertion": {sign(other, map[string]any{"iss": email, "aud": tokenURI, "iat": now, "exp": now + 3600})}},
+		{"grant_type": {jwtBearer}, "assertion": {sign(priv, map[string]any{"iss": email, "aud": "https://storage.googleapis.com/", "iat": now, "exp": now + 3600})}},
+		{"grant_type": {"refresh_token"}, "refresh_token": {"proxy-injected"}},
+	} {
+		if code, _ := post(f); code != 400 {
+			t.Error(f.Get("grant_type"), code)
+		}
+	}
+}
+
+func BenchmarkVerifyUncached(b *testing.B) {
+	k, priv := setup(b)
+	now := time.Now().Unix()
+	tok := sign(priv, map[string]any{"iss": email, "aud": "https://storage.googleapis.com/", "iat": now, "exp": now + 3600})
+	b.ResetTimer()
+	for b.Loop() {
+		if _, _, err := k.verify(tok); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkBearerCached(b *testing.B) {
+	k, priv := setup(b)
+	now := time.Now().Unix()
+	tok := sign(priv, map[string]any{"iss": email, "aud": "https://storage.googleapis.com/", "iat": now, "exp": now + 3600})
+	k.Bearer(tok, "storage.googleapis.com")
+	b.ResetTimer()
+	for b.Loop() {
+		if !k.Bearer(tok, "storage.googleapis.com") {
+			b.Fatal()
+		}
+	}
+}
