+	"strings"
+	"sync"
+	"testing"
+)
+
+// SPIKE: Artifact Registry's Docker flow on a basicUser route. docker (or
+// docker-credential-gcloud, user _dcgcloud_token) sends Basic with the
+// placeholder as the password to the realm; the registry hands back a
+// registry token, which the client then uses as Bearer.
+func TestSpikeArtifactRegistryBasic(t *testing.T) {
+	const sfx = "pkg.test"
+	uca, _ := NewCA([]string{"*." + sfx})
+	var mu sync.Mutex
+	var seen []string
+	up := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		a := r.Header.Get("Authorization")
+		if user, pass, ok := r.BasicAuth(); ok {
+			a = "Basic " + user + ":" + pass
+		}
+		mu.Lock()
+		seen = append(seen, r.URL.Path+" "+a)
+		mu.Unlock()
+		switch {
+		case r.URL.Path == "/v2/token":
+			if a != "Basic oauth2accesstoken:"+realToken {
+				w.WriteHeader(401)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"token": "registry-issued-token", "expires_in": 3600})
+		case a == "Bearer registry-issued-token":
+			_, _ = io.WriteString(w, `{"schemaVersion":2}`)
+		default:
+			w.Header().Set("WWW-Authenticate", `Bearer realm="https://`+r.Host+`/v2/token",service="`+r.Host+`",scope="repository:p/r/i:pull"`)
+			w.WriteHeader(401)
+		}
+	}))
+	up.TLS = &tls.Config{GetCertificate: func(h *tls.ClientHelloInfo) (*tls.Certificate, error) { return uca.Leaf(h.ServerName) }}
+	up.StartTLS()
+	t.Cleanup(up.Close)
+	pool := up.Client().Transport.(*http.Transport).TLSClientConfig.RootCAs
+	pool.AddCert(uca.Certificate())
+	_, port, _ := net.SplitHostPort(up.Listener.Addr().String())
+
+	j := &journal{}
+	cred, _ := tokenFile(t, j, realToken+"\n")
+	rt := Route{Name: "artifact-registry", Host: "*." + sfx, Upstream: "https://*." + sfx + ":" + port, UpstreamCAs: pool,
+		Credential: cred, Inject: BasicUser("oauth2accesstoken"), Placeholder: placeholder,
+		Scope: Scope{Paths: []PathRule{{Methods: []string{"GET", "HEAD"}, Prefix: "/v2/"}}}}
+	ic, err := New(Config{Routes: []Route{rt}, Log: slog.New(slog.NewJSONHandler(j, nil)), Policy: "p",
+		DialContext: func(ctx context.Context, n, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, n, up.Listener.Addr().String())
+		}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ic.Close() })
+	ca, _ := NewCA(ic.Hosts())
+	f := &fixture{ca: ca, journal: j, ic: ic}
+	f.addr = listen(t, j, "sess", ic.For(ca, "/w"))
+	c := f.client(t, true)
+	host := "us-docker." + sfx
+
+	req, _ := http.NewRequest("GET", "https://"+host+"/v2/p/r/i/manifests/latest", nil)
+	res, _ := get(t, c, req)
+	chal := res.Header.Get("WWW-Authenticate")
+	t.Logf("anonymous: %d %s", res.StatusCode, chal)
+
+	for _, user := range []string{"oauth2accesstoken", "_dcgcloud_token"} {
+		req, _ = http.NewRequest("GET", "https://"+host+"/v2/token?scope=repository:p/r/i:pull&service="+host, nil)
+		req.Header.Set("Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte(user+":"+placeholder)))
+		res, body := get(t, c, req)
+		t.Logf("token as %s: %d %s", user, res.StatusCode, strings.TrimSpace(body))
+		if res.StatusCode != 200 {
+			t.Fatalf("token: %d", res.StatusCode)
+		}
+		var tr struct{ Token string }
+		_ = json.Unmarshal([]byte(body), &tr)
+		req, _ = http.NewRequest("GET", "https://"+host+"/v2/p/r/i/manifests/latest", nil)
+		req.Header.Set("Authorization", "Bearer "+tr.Token)
+		res, body = get(t, c, req)
+		t.Logf("manifest with registry token: %d %s", res.StatusCode, body)
+		if res.StatusCode != 200 {
+			t.Fatal(res.StatusCode)
+		}
+	}
+	// Basic on every request, the placeholder as password (what some clients,
+	// crane/ko with a static keychain, do): replaced each time.
+	req = newRequest(t, "GET", "https://"+host+"/v2/p/r/i/manifests/latest", nil)
+	req.Header.Set("Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte("oauth2accesstoken:"+placeholder)))
+	res, _ = get(t, c, req)
+	t.Logf("direct Basic: %d", res.StatusCode)
+
+	mu.Lock()
+	defer mu.Unlock()
+	for _, s := range seen {
+		t.Logf("upstream saw: %s", s)
+		if strings.Contains(s, placeholder) {
+			t.Fatalf("placeholder reached upstream: %s", s)
+		}
+	}
+	for _, l := range j.lines(t, "request") {
+		t.Logf("log: path=%v credential=%v status=%v", l["path"], l["credential"], l["status"])
+	}
+}
