--- /dev/null
+++ b/internal/metadata/token.go
@@ -0,0 +1,34 @@
+package metadata
+
+import (
+	"encoding/json"
+	"net/http"
+)
+
+// TokenEndpoint answers oauth2.googleapis.com/token for a placeholder
+// authorized_user credential: a refresh-token grant carrying the placeholder
+// gets the placeholder back as the access token. Anything else is
+// invalid_grant, and nothing is ever sent to Google. SPIKE.
+func TokenEndpoint(placeholder string, expiresIn int) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json; charset=utf-8")
+		w.Header().Set("Cache-Control", "no-store")
+		if r.Method != http.MethodPost || r.URL.Path != "/token" {
+			w.WriteHeader(http.StatusNotFound)
+			_ = json.NewEncoder(w).Encode(map[string]string{"error": "not_found"})
+			return
+		}
+		r.Body = http.MaxBytesReader(w, r.Body, 64<<10)
+		if err := r.ParseForm(); err != nil || r.PostForm.Get("grant_type") != "refresh_token" || r.PostForm.Get("refresh_token") != placeholder {
+			w.WriteHeader(http.StatusBadRequest)
+			_ = json.NewEncoder(w).Encode(map[string]string{"error": "invalid_grant", "error_description": "frisket answers only its placeholder"})
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": placeholder,
+			"expires_in":   expiresIn,
+			"token_type":   "Bearer",
+			"scope":        "https://www.googleapis.com/auth/cloud-platform",
+		})
+	})
+}
