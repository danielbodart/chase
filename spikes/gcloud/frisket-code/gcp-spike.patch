+package intercept
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// SPIKE: one route for every name below a suffix.
+
+const gSuffix = "googleapis.test"
+
+// wildUpstream serves every name below gSuffix, minting per SNI from a CA of
+// its own, and records which host and credential each request arrived with.
+func wildUpstream(t *testing.T) (addr string, pool *x509.CertPool, got func() []string) {
+	t.Helper()
+	uca, err := NewCA([]string{"*." + gSuffix})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var mu sync.Mutex
+	var seen []string
+	srv := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seen = append(seen, r.TLS.ServerName+" "+r.Host+" "+r.Header.Get("Authorization"))
+		mu.Unlock()
+		_, _ = io.WriteString(w, "hello from "+r.Host)
+	}))
+	srv.EnableHTTP2 = true
+	srv.TLS = &tls.Config{GetCertificate: func(h *tls.ClientHelloInfo) (*tls.Certificate, error) {
+		return uca.Leaf(h.ServerName)
+	}}
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+	pool = x509.NewCertPool()
+	pool.AddCert(uca.Certificate())
+	return srv.Listener.Addr().String(), pool, func() []string {
+		mu.Lock()
+		defer mu.Unlock()
+		return append([]string(nil), seen...)
+	}
+}
+
+func TestSpikeWildcardRoute(t *testing.T) {
+	protos(t, func(t *testing.T, h2 bool) {
+		addr, pool, seen := wildUpstream(t)
+		_, port, _ := net.SplitHostPort(addr)
+		j := &journal{}
+		cred, _ := tokenFile(t, j, realToken+"\n")
+		rt := Route{
+			Name:        "google",
+			Host:        "*." + gSuffix,
+			Upstream:    "https://*." + gSuffix + ":" + port,
+			UpstreamCAs: pool,
+			Credential:  cred,
+			Inject:      Bearer(),
+			Placeholder: placeholder,
+			Scope:       Scope{Paths: []PathRule{{Methods: []string{"GET"}, Prefix: "/"}}},
+		}
+		ca, err := NewCA([]string{rt.Host})
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Logf("CA constraint: %q", ca.Certificate().PermittedDNSDomains)
+		var dialled []string
+		var dmu sync.Mutex
+		ic, err := New(Config{
+			Routes: []Route{rt},
+			Log:    slog.New(slog.NewJSONHandler(j, nil)),
+			Policy: "p",
+			DialContext: func(ctx context.Context, network, a string) (net.Conn, error) {
+				dmu.Lock()
+				dialled = append(dialled, a)
+				dmu.Unlock()
+				return (&net.Dialer{}).DialContext(ctx, network, addr)
+			},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = ic.Close() })
+		f := &fixture{ca: ca, journal: j, ic: ic}
+		f.addr = listen(t, j, "sess", ic.For(ca, "/w"))
+		c := f.client(t, h2)
+
+		for _, host := range []string{"storage." + gSuffix, "us-central1-aiplatform." + gSuffix, "a.b." + gSuffix} {
+			res, body := get(t, c, newRequest(t, "GET", "https://"+host+"/v1/x", nil))
+			if res.StatusCode != 200 || body != "hello from "+host+":"+port {
+				t.Fatalf("%s: %d %q", host, res.StatusCode, body)
+			}
+			if res.TLS.PeerCertificates[0].Subject.CommonName != host {
+				t.Fatalf("%s: leaf for %q", host, res.TLS.PeerCertificates[0].Subject.CommonName)
+			}
+		}
+		for _, s := range seen() {
+			parts := strings.SplitN(s, " ", 3)
+			if parts[0]+":"+port != parts[1] || parts[2] != "Bearer "+realToken {
+				t.Fatalf("upstream saw %q", s)
+			}
+		}
+		t.Logf("upstream saw (sni host auth): %q", seen())
+		t.Logf("frisket dialled: %q", dialled)
+
+		// The suffix itself, a look-alike, and another name are refused at the
+		// handshake -- nothing minted, nothing dialled.
