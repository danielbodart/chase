+// allowCovers is whether every name h stands for is allowed. SPIKE: a
+// wildcard is covered by "*" or by a wildcard at or above its suffix, which a
+// name one label below the suffix tests; an exact name cannot cover one.
+func allowCovers(allow *dns.Matcher, h string) bool {
+	if suffix, ok := strings.CutPrefix(h, "*."); ok {
+		for _, p := range allow.Patterns() {
+			if p.Any || p.Wildcard && (p.Name == suffix || strings.HasSuffix(suffix, "."+p.Name)) {
+				return true
+			}
+		}
+		return false
+	}
+	return allow.Match(h)
+}
