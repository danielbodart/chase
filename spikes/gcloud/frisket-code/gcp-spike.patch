+package metadata
+
+import (
+	"testing"
+	"time"
+
+	"github.com/danielbodart/frisket/internal/credential"
+)
+
+// SPIKE: which shapes of a host refresher's token file the existing
+// extractors read, with an expiry.
+func TestSpikeTokenFileShapes(t *testing.T) {
+	exp := time.Now().Add(50 * time.Minute).Truncate(time.Second)
+	cases := []struct {
+		name string
+		ex   credential.Extractor
+		file string
+	}{
+		{"bare token (gcloud auth print-access-token)", credential.Trimmed(), "ya29.a0AfB\n"},
+		{"millis", credential.JSON{Token: "access_token", ExpiresMillis: "expiry_ms"}.Extract,
+			`{"access_token":"ya29.a0AfB","expiry_ms":` + itoa(exp.UnixMilli()) + `}`},
+		{"RFC 3339 (x/oauth2 Token, google-auth to_json, gcloud --format=json)", credential.JSON{Token: "access_token", ExpiresMillis: "expiry"}.Extract,
+			`{"access_token":"ya29.a0AfB","expiry":"` + exp.UTC().Format(time.RFC3339) + `"}`},
+		{"expires_in seconds (token endpoint response)", credential.JSON{Token: "access_token", ExpiresMillis: "expires_in"}.Extract,
+			`{"access_token":"ya29.a0AfB","expires_in":3599}`},
+		{"opaque token as JWT", credential.JSON{Token: "access_token", ExpiresJWT: "access_token"}.Extract,
+			`{"access_token":"ya29.a0AfB"}`},
+	}
+	for _, c := range cases {
+		s, err := c.ex([]byte(c.file))
+		t.Logf("%-70s err=%v expires=%v expired-now=%v", c.name, err, s.Expires, err == nil && s.Expired(time.Now()))
+	}
+}
+
+func itoa(n int64) string {
+	b := []byte{}
+	for n > 0 {
+		b = append([]byte{byte('0' + n%10)}, b...)
+		n /= 10
+	}
+	return string(b)
+}
