+package intercept
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/danielbodart/frisket/internal/credential"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+// SPIKE: does a gRPC call survive the intercept path?
+
+const upstreamName = "upstream.test"
+
+type echoServer interface{}
+
+type seen struct {
+	mu   sync.Mutex
+	auth []string
+	te   []string
+}
+
+func (s *seen) add(auth, te string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.auth = append(s.auth, auth)
+	if te != "" {
+		s.te = append(s.te, te)
+	}
+}
+
+func authOf(ctx context.Context) string {
+	md, _ := metadata.FromIncomingContext(ctx)
+	return strings.Join(md.Get("authorization"), ",")
+}
+
+func echoDesc(s *seen) *grpc.ServiceDesc {
+	return &grpc.ServiceDesc{
+		ServiceName: "spike.Echo",
+		HandlerType: (*echoServer)(nil),
+		Methods: []grpc.MethodDesc{{
+			MethodName: "Say",
+			Handler: func(_ any, ctx context.Context, dec func(any) error, _ grpc.UnaryServerInterceptor) (any, error) {
+				in := new(wrapperspb.BytesValue)
+				if err := dec(in); err != nil {
+					return nil, err
+				}
+				s.add(authOf(ctx), "")
+				if string(in.Value) == "fail" {
+					// A trailers-only response: grpc-status in the one HEADERS frame.
+					return nil, status.Error(codes.PermissionDenied, "no, said upstream")
+				}
+				_ = grpc.SetTrailer(ctx, metadata.Pairs("x-upstream-trailer", "t1"))
+				return wrapperspb.Bytes(append([]byte("echo:"), in.Value...)), nil
+			},
+		}},
+		Streams: []grpc.StreamDesc{{
+			StreamName:    "Chat",
+			ServerStreams: true,
+			ClientStreams: true,
+			Handler: func(_ any, st grpc.ServerStream) error {
+				s.add(authOf(st.Context()), "")
+				n := 0
+				for {
+					in := new(wrapperspb.BytesValue)
+					err := st.RecvMsg(in)
+					if errors.Is(err, io.EOF) {
+						st.SetTrailer(metadata.Pairs("x-upstream-trailer", fmt.Sprint(n)))
+						return status.Error(codes.FailedPrecondition, fmt.Sprintf("done after %d", n))
+					}
+					if err != nil {
+						return err
+					}
+					n++
+					if strings.HasPrefix(string(in.Value), "sleep") {
+						time.Sleep(300 * time.Millisecond)
+					}
+					if err := st.SendMsg(wrapperspb.Bytes(in.Value)); err != nil {
+						return err
+					}
+				}
+			},
+		}},
+	}
+}
+
+// grpcUpstream is a real gRPC server on TLS as upstream.test, with a CA the
+// sandbox never sees. native: grpc-go's own HTTP/2 transport; otherwise
+// grpc.Server.ServeHTTP behind net/http, which lets the test see TE.
+func grpcUpstream(t *testing.T, native bool) (addr string, pool *x509.CertPool, s *seen) {
+	t.Helper()
+	ca, err := NewCA([]string{upstreamName})
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf, err := ca.Leaf(upstreamName)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool = x509.NewCertPool()
+	pool.AddCert(ca.Certificate())
+	s = &seen{}
+	gs := grpc.NewServer(grpc.MaxRecvMsgSize(64<<20), grpc.MaxSendMsgSize(64<<20))
+	gs.RegisterService(echoDesc(s), nil)
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Skip(err)
+	}
+	tc := &tls.Config{Certificates: []tls.Certificate{*leaf}, NextProtos: []string{"h2"}}
+	if native {
+		go func() { _ = gs.Serve(tls.NewListener(ln, tc)) }()
+		t.Cleanup(gs.Stop)
+	} else {
+		var p http.Protocols
+		p.SetHTTP2(true)
+		hs := &http.Server{Protocols: &p, TLSConfig: tc, Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			s.add("", r.Header.Get("Te"))
+			gs.ServeHTTP(w, r)
+		})}
+		go func() { _ = hs.ServeTLS(ln, "", "") }()
+		t.Cleanup(func() { _ = hs.Close() })
+	}
+	return ln.Addr().String(), pool, s
+}
+
+func grpcFixture(t *testing.T, native bool) (*grpc.ClientConn, *seen, *journal) {
+	t.Helper()
+	addr, pool, s := grpcUpstream(t, native)
+	_, port, _ := net.SplitHostPort(addr)
+	j := &journal{}
+	cred, _ := tokenFile(t, j, realToken+"\n")
+	rt := Route{
+		Name:        "gcp",
+		Host:        apiHost,
+		Upstream:    "https://" + upstreamName + ":" + port,
+		UpstreamCAs: pool,
+		Credential:  cred,
+		Inject:      Bearer(),
+		Placeholder: placeholder,
+		Scope:       Scope{Paths: []PathRule{{Methods: []string{"POST"}, Prefix: "/spike.Echo/"}}},
+	}
+	ca, err := NewCA([]string{apiHost})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ic, err := New(Config{
+		Routes: []Route{rt},
+		Log:    slog.New(slog.NewJSONHandler(j, nil)),
+		Policy: "p",
+		DialContext: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, network, addr)
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ic.Close() })
+	faddr := listen(t, j, "sess", ic.For(ca, "/w"))
+	roots := x509.NewCertPool()
+	roots.AddCert(ca.Certificate())
+	cc, err := grpc.NewClient("passthrough:///"+apiHost+":443",
+		grpc.WithTransportCredentials(credentials.NewTLS(&tls.Config{RootCAs: roots, ServerName: apiHost})),
+		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "tcp", faddr)
+		}),
+		grpc.WithDefaultCallOptions(grpc.MaxCallRecvMsgSize(64<<20), grpc.MaxCallSendMsgSize(64<<20)),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cc.Close() })
+	return cc, s, j
+}
+
+func withPlaceholder(ctx context.Context) context.Context {
+	return metadata.AppendToOutgoingContext(ctx, "authorization", "Bearer "+placeholder)
+}
+
+func bothUpstreams(t *testing.T, fn func(t *testing.T, native bool)) {
+	t.Run("native", func(t *testing.T) { fn(t, true) })
+	t.Run("servehttp", func(t *testing.T) { fn(t, false) })
+}
+
+func TestSpikeGRPCUnary(t *testing.T) {
+	bothUpstreams(t, func(t *testing.T, native bool) {
+		cc, s, j := grpcFixture(t, native)
+		ctx, cancel := context.WithTimeout(withPlaceholder(context.Background()), 10*time.Second)
+		defer cancel()
+
+		out := new(wrapperspb.BytesValue)
+		var trailer, header metadata.MD
+		err := cc.Invoke(ctx, "/spike.Echo/Say", wrapperspb.Bytes([]byte("hi")), out, grpc.Trailer(&trailer), grpc.Header(&header))
+		if err != nil {
+			t.Fatalf("unary: %v", err)
+		}
+		if string(out.Value) != "echo:hi" {
+			t.Fatalf("got %q", out.Value)
+		}
+		if got := trailer.Get("x-upstream-trailer"); len(got) != 1 || got[0] != "t1" {
+			t.Fatalf("trailer lost: %v", trailer)
+		}
+
+		err = cc.Invoke(ctx, "/spike.Echo/Say", wrapperspb.Bytes([]byte("fail")), out)
+		if st, _ := status.FromError(err); st.Code() != codes.PermissionDenied || st.Message() != "no, said upstream" {
+			t.Fatalf("trailers-only status lost: %v", err)
+		}
+
+		// 8 MiB each way: far past HTTP/2's 64 KiB initial window on both hops.
+		big := make([]byte, 8<<20)
+		for i := range big {
+			big[i] = byte(i)
+		}
+		if err := cc.Invoke(ctx, "/spike.Echo/Say", wrapperspb.Bytes(big), out); err != nil {
+			t.Fatalf("8 MiB unary: %v", err)
+		}
+		if len(out.Value) != len(big)+5 {
+			t.Fatalf("8 MiB came back as %d", len(out.Value))
+		}
+
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		for _, a := range s.auth {
+			if a != "" && a != "Bearer "+realToken {
+				t.Fatalf("upstream saw authorization %q", a)
+			}
+		}
+		if !native {
+			for _, te := range s.te {
+				if te != "trailers" {
+					t.Fatalf("upstream saw TE %q", te)
+				}
+			}
+			if len(s.te) == 0 {
+				t.Fatal("upstream saw no TE")
+			}
+		}
+		t.Logf("auth seen upstream: %q te: %q", s.auth, s.te)
+		lines := j.waitLines(t, "request", 3)
+		for _, l := range lines {
+			t.Logf("log: proto=%v status=%v credential=%v path=%v", l["proto"], l["status"], l["credential"], l["path"])
+		}
+	})
+}
+
+func TestSpikeGRPCBidiStream(t *testing.T) {
+	bothUpstreams(t, func(t *testing.T, native bool) {
+		old := idleTimeout
+		idleTimeout = 500 * time.Millisecond
+		t.Cleanup(func() { idleTimeout = old })
+
+		cc, s, _ := grpcFixture(t, native)
+		ctx, cancel := context.WithTimeout(withPlaceholder(context.Background()), 20*time.Second)
+		defer cancel()
+		st, err := cc.NewStream(ctx, &grpc.StreamDesc{ServerStreams: true, ClientStreams: true}, "/spike.Echo/Chat")
+		if err != nil {
+			t.Fatal(err)
+		}
+		// Ping-pong: each reply must arrive before the next message is sent,
+		// so nothing on the path may buffer a stream in either direction.
+		// The sleeps take the stream past the (shrunk) idle timeout.
+		for i := range 6 {
+			msg := fmt.Sprintf("m%d", i)
+			if i%2 == 1 {
+				msg = "sleep" + msg
+			}
+			if i == 3 {
+				// Idle on an open stream for three idle timeouts.
+				time.Sleep(1500 * time.Millisecond)
+			}
+			start := time.Now()
+			if err := st.SendMsg(wrapperspb.Bytes([]byte(msg))); err != nil {
+				t.Fatalf("send %d: %v", i, err)
+			}
+			in := new(wrapperspb.BytesValue)
+			if err := st.RecvMsg(in); err != nil {
+				t.Fatalf("recv %d: %v", i, err)
+			}
+			if string(in.Value) != msg {
+				t.Fatalf("recv %d: %q", i, in.Value)
+			}
+			t.Logf("round trip %d: %v", i, time.Since(start))
+		}
+		if err := st.CloseSend(); err != nil {
+			t.Fatal(err)
+		}
+		err = st.RecvMsg(new(wrapperspb.BytesValue))
+		sts, _ := status.FromError(err)
+		if sts.Code() != codes.FailedPrecondition || sts.Message() != "done after 6" {
+			t.Fatalf("stream status lost: %v", err)
+		}
+		if got := st.Trailer().Get("x-upstream-trailer"); len(got) != 1 || got[0] != "6" {
+			t.Fatalf("stream trailer lost: %v", st.Trailer())
+		}
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		for _, a := range s.auth {
+			if a != "" && a != "Bearer "+realToken {
+				t.Fatalf("upstream saw authorization %q", a)
+			}
+		}
+		t.Logf("auth seen upstream: %q te: %q", s.auth, s.te)
+	})
+}
+
+// A client cancelling a stream mid-flight must reach the upstream as a cancel.
+func TestSpikeGRPCCancelReachesUpstream(t *testing.T) {
+	cc, _, _ := grpcFixture(t, true)
+	ctx, cancel := context.WithCancel(withPlaceholder(context.Background()))
+	st, err := cc.NewStream(ctx, &grpc.StreamDesc{ServerStreams: true, ClientStreams: true}, "/spike.Echo/Chat")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := st.SendMsg(wrapperspb.Bytes([]byte("a"))); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.RecvMsg(new(wrapperspb.BytesValue)); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	err = st.RecvMsg(new(wrapperspb.BytesValue))
+	if status.Code(err) != codes.Canceled {
+		t.Fatalf("got %v", err)
+	}
+}
+
+// What a gRPC client makes of frisket's own refusals: out of scope (403) and
+// a stale credential (503), neither carrying grpc-status.
+func TestSpikeGRPCRefusals(t *testing.T) {
+	cc, _, _ := grpcFixture(t, true)
+	ctx, cancel := context.WithTimeout(withPlaceholder(context.Background()), 10*time.Second)
+	defer cancel()
+	err := cc.Invoke(ctx, "/other.Svc/Do", wrapperspb.Bytes(nil), new(wrapperspb.BytesValue))
+	t.Logf("out of scope: code=%v err=%v", status.Code(err), err)
+	if status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestSpikeGRPCStaleCredential(t *testing.T) {
+	addr, pool, _ := grpcUpstream(t, true)
+	_, port, _ := net.SplitHostPort(addr)
+	j := &journal{}
+	rt := Route{
+		Name: "gcp", Host: apiHost, Upstream: "https://" + upstreamName + ":" + port, UpstreamCAs: pool,
+		Credential: staleSource{}, Inject: Bearer(), Placeholder: placeholder,
+		Scope: Scope{Paths: []PathRule{{Methods: []string{"POST"}, Prefix: "/spike.Echo/"}}},
+	}
