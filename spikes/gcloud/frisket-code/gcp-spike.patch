+// With h2 the client pools connections by host, so each name got its own
+// connection above. A request for another name on a connection -- h2
+// coalescing, which Go does not do and browsers do -- is 421.
+func TestSpikeWildcardCrossHostOnOneConnIsMisdirected(t *testing.T) {
+	addr, pool, _ := wildUpstream(t)
+	_, port, _ := net.SplitHostPort(addr)
+	j := &journal{}
+	cred, _ := tokenFile(t, j, realToken+"\n")
+	rt := Route{Name: "google", Host: "*." + gSuffix, Upstream: "https://*." + gSuffix + ":" + port, UpstreamCAs: pool,
+		Credential: cred, Inject: Bearer(), Placeholder: placeholder,
+		Scope: Scope{Paths: []PathRule{{Methods: []string{"GET"}, Prefix: "/"}}}}
+	ca, _ := NewCA([]string{rt.Host})
+	ic, err := New(Config{Routes: []Route{rt}, Log: slog.New(slog.NewJSONHandler(j, nil)), Policy: "p",
+		DialContext: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, network, addr)
+		}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ic.Close() })
+	faddr := listen(t, j, "sess", ic.For(ca, "/w"))
+	roots := x509.NewCertPool()
+	roots.AddCert(ca.Certificate())
+	tc, err := tls.Dial("tcp", faddr, &tls.Config{RootCAs: roots, ServerName: "a." + gSuffix, NextProtos: []string{"http/1.1"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tc.Close()
+	_, _ = io.WriteString(tc, "GET / HTTP/1.1\r\nHost: b."+gSuffix+"\r\nAuthorization: Bearer "+placeholder+"\r\n\r\n")
+	buf := make([]byte, 64)
+	n, _ := tc.Read(buf)
+	if !strings.HasPrefix(string(buf[:n]), "HTTP/1.1 421") {
+		t.Fatalf("got %q", buf[:n])
+	}
+}
+
+// The constraint, as Go's verifier reads it; and PEMs for other verifiers.
+func TestSpikeWildcardConstraintGo(t *testing.T) {
+	if os.Getenv("SPIKE_DOT") != "" {
+		WildcardLeadingDot = true
+		t.Cleanup(func() { WildcardLeadingDot = false })
+	}
+	ca, err := NewCA([]string{"*." + gSuffix, "api.example.test"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("permitted: %q", ca.Certificate().PermittedDNSDomains)
+	roots := x509.NewCertPool()
+	roots.AddCert(ca.Certificate())
+	out := os.Getenv("SPIKE_PEM_DIR")
+	if out != "" {
+		_ = os.WriteFile(filepath.Join(out, "ca.pem"), ca.CertPEM(), 0o644)
+	}
+	cases := map[string]bool{
+		"storage." + gSuffix:                true,
+		"us-central1-aiplatform." + gSuffix: true,
+		"a.b." + gSuffix:                    true,
+		"*." + gSuffix:                      true, // a wildcard leaf
+		gSuffix:                             os.Getenv("SPIKE_DOT") == "",
+		"evil" + gSuffix:                    false,
+		"example.test":                      false,
+		"api.example.test":                  true,
+	}
+	for name, want := range cases {
+		// Mint directly: Leaf mints for whatever it is given.
+		cert, _, err := ca.mint(name, time.Now())
+		if err != nil {
+			t.Fatal(err)
+		}
+		leaf := cert.Leaf
+		_, verr := leaf.Verify(x509.VerifyOptions{Roots: roots})
+		if (verr == nil) != want {
+			t.Errorf("%s: Go verify err=%v, want ok=%v", name, verr, want)
+		}
+		// Hostname check separately, for the wildcard leaf.
+		if name == "*."+gSuffix {
+			if err := leaf.VerifyHostname("storage." + gSuffix); err != nil {
+				t.Errorf("wildcard leaf does not cover storage: %v", err)
+			}
+			if err := leaf.VerifyHostname("a.b." + gSuffix); err == nil {
+				t.Errorf("wildcard leaf covers two labels")
+			}
+		}
+		t.Logf("Go: %-40s verify ok=%v", name, verr == nil)
+		if out != "" {
+			fn := strings.ReplaceAll(name, "*", "STAR") + ".pem"
+			_ = os.WriteFile(filepath.Join(out, fn), pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: leaf.Raw}), 0o644)
+		}
+	}
+}
+
+// Minting per SNI is the cost of a wildcard: names are the workload's to
+// invent. How much is one?
+func BenchmarkSpikeMint(b *testing.B) {
+	ca, err := NewCA([]string{"*." + gSuffix})
+	if err != nil {
+		b.Fatal(err)
+	}
+	now := time.Now()
+	for b.Loop() {
+		if _, _, err := ca.mint("x."+gSuffix, now); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+// A token-minting API under the suffix (iamcredentials generateAccessToken
+// returns a real token in its body) is shadowed by an exact route that holds
+// no credential and admits nothing: the exact name wins over the wildcard.
+func TestSpikeWildcardShadowedByExactRoute(t *testing.T) {
+	addr, pool, seen := wildUpstream(t)
+	_, port, _ := net.SplitHostPort(addr)
+	j := &journal{}
+	cred, _ := tokenFile(t, j, realToken+"\n")
+	routes := []Route{
+		{Name: "google", Host: "*." + gSuffix, Upstream: "https://*." + gSuffix + ":" + port, UpstreamCAs: pool,
+			Credential: cred, Inject: Bearer(), Placeholder: placeholder,
+			Scope: Scope{Paths: []PathRule{{Methods: []string{"GET", "POST"}, Prefix: "/"}}}},
+		{Name: "iamcredentials", Host: "iamcredentials." + gSuffix, Upstream: "https://iamcredentials." + gSuffix + ":" + port, UpstreamCAs: pool,
+			Scope: Scope{Paths: []PathRule{{Methods: []string{"GET", "POST"}, Prefix: "/", Refuse: true}}}},
+	}
+	ic, err := New(Config{Routes: routes, Log: slog.New(slog.NewJSONHandler(j, nil)), Policy: "p",
+		DialContext: func(ctx context.Context, n, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, n, addr)
+		}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ic.Close() })
+	ca, _ := NewCA(ic.Hosts())
+	f := &fixture{ca: ca, journal: j, ic: ic}
+	f.addr = listen(t, j, "sess", ic.For(ca, "/w"))
+	c := f.client(t, true)
+	res, body := get(t, c, newRequest(t, "POST", "https://iamcredentials."+gSuffix+"/v1/projects/-/serviceAccounts/sa@p.iam.gserviceaccount.com:generateAccessToken", nil))
+	t.Logf("generateAccessToken: %d %q", res.StatusCode, body)
+	res2, _ := get(t, c, newRequest(t, "GET", "https://storage."+gSuffix+"/b", nil))
+	t.Logf("storage: %d; upstream saw %q", res2.StatusCode, seen())
+	if res.StatusCode != 403 || res2.StatusCode != 200 || len(seen()) != 1 {
+		t.Fatal("shadowing failed")
+	}
+}
diff --git a/internal/metadata/metadata.go b/internal/metadata/metadata.go
new file mode 100644
index 0000000..80a1cbe
--- /dev/null
+++ b/internal/metadata/metadata.go
@@ -0,0 +1,248 @@
+// Package metadata is a GCE metadata server on frisket's service address,
+// port 80: what the Google client libraries and gcloud probe for credentials.
+// SPIKE.
+//
+// It hands out the route's placeholder as the access token. The real token
+// never leaves the daemon: the Google API route replaces the placeholder on
+// the wire, as it does for any other route.
+package metadata
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/danielbodart/frisket/internal/credential"
+	"github.com/danielbodart/frisket/internal/steer"
+)
+
+// Port is where clients look: GCE_METADATA_HOST without a port is port 80.
+const Port = 80
+
+// Config is what the server says about the "instance".
+type Config struct {
+	ProjectID        string
+	NumericProjectID string
+	Email            string
+	UniverseDomain   string // "" is googleapis.com
+	Scopes           []string
+	// Placeholder is the access token handed out, which the route replaces.
+	Placeholder string
+	// Credential is the route's, read only for its expiry, so the token's
+	// expires_in tracks the real one's. Nil: a fixed hour.
+	Credential credential.Source
+	Log        *slog.Logger
+	Now        func() time.Time
+}
+
+// Server serves Config over plain HTTP, one steered connection at a time.
+type Server struct {
+	cfg  Config
+	srv  *http.Server
+	ln   *chanListener
+	once sync.Once
+}
+
+func New(cfg Config) *Server {
+	if cfg.UniverseDomain == "" {
+		cfg.UniverseDomain = "googleapis.com"
+	}
+	if cfg.Now == nil {
+		cfg.Now = time.Now
+	}
+	if len(cfg.Scopes) == 0 {
+		cfg.Scopes = []string{"https://www.googleapis.com/auth/cloud-platform"}
+	}
+	s := &Server{cfg: cfg, ln: &chanListener{ch: make(chan net.Conn), closed: make(chan struct{})}}
+	s.srv = &http.Server{Handler: s, ReadHeaderTimeout: 10 * time.Second, IdleTimeout: time.Minute}
+	go func() { _ = s.srv.Serve(s.ln) }()
+	return s
+}
+
+func (s *Server) Close() error {
+	s.once.Do(func() { close(s.ln.closed) })
+	return s.srv.Close()
+}
+
+var _ steer.Handler = (*Server)(nil)
+
+// ServeConn serves one steered connection until it closes.
+func (s *Server) ServeConn(ctx context.Context, c *steer.Conn) {
+	dc := &doneConn{Conn: c, done: make(chan struct{})}
+	select {
+	case s.ln.ch <- dc:
+	case <-s.ln.closed:
+		_ = c.Close()
+		return
+	case <-ctx.Done():
+		_ = c.Close()
+		return
+	}
+	select {
+	case <-dc.done:
+	case <-ctx.Done():
+		_ = dc.Close()
+	}
+}
+
+const prefix = "/computeMetadata/v1/"
+
+func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Metadata-Flavor", "Google")
+	w.Header().Set("Server", "Metadata Server for VM")
+	status := s.serve(w, r)
+	if s.cfg.Log != nil {
+		s.cfg.Log.Info("metadata", "method", r.Method, "path", r.URL.Path, "status", status)
+	}
+}
+
+func (s *Server) serve(w http.ResponseWriter, r *http.Request) int {
+	// What GCE does: a request that came through a proxy is refused, which
+	// stops a server-side request forgery reading the token.
+	if r.Header.Get("X-Forwarded-For") != "" {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return http.StatusForbidden
+	}
+	if r.Method != http.MethodGet {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return http.StatusMethodNotAllowed
+	}
+	if r.URL.Path == "/" {
+		// The detection ping: python's google-auth checks only the response's
+		// Metadata-Flavor.
+		_, _ = w.Write([]byte("computeMetadata/\n"))
+		return http.StatusOK
+	}
+	if r.Header.Get("Metadata-Flavor") != "Google" {
+		http.Error(w, "Missing Metadata-Flavor:Google header.", http.StatusForbidden)
+		return http.StatusForbidden
+	}
+	p, ok := strings.CutPrefix(r.URL.Path, prefix)
+	if !ok {
+		http.NotFound(w, r)
+		return http.StatusNotFound
+	}
+	recursive := r.URL.Query().Get("recursive") == "true"
+	text := func(v string) int {
+		w.Header().Set("Content-Type", "application/text")
+		_, _ = w.Write([]byte(v))
+		return http.StatusOK
+	}
+	js := func(v any) int {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(v)
+		return http.StatusOK
+	}
+	account := func(name string) (string, bool) {
+		switch name {
+		case "default", s.cfg.Email:
+			return s.cfg.Email, true
+		}
+		return "", false
+	}
+	switch {
+	case p == "project/project-id":
+		return text(s.cfg.ProjectID)
+	case p == "project/numeric-project-id":
+		return text(s.cfg.NumericProjectID)
+	case p == "universe/universe-domain":
+		return text(s.cfg.UniverseDomain)
+	case p == "instance/service-accounts" || p == "instance/service-accounts/":
+		if recursive {
+			sa := s.account()
+			return js(map[string]any{"default": sa, s.cfg.Email: sa})
+		}
+		return text("default/\n" + s.cfg.Email + "/\n")
+	case strings.HasPrefix(p, "instance/service-accounts/"):
+		rest := strings.TrimPrefix(p, "instance/service-accounts/")
+		name, leaf, _ := strings.Cut(rest, "/")
+		if _, ok := account(name); !ok {
+			http.NotFound(w, r)
+			return http.StatusNotFound
+		}
+		switch leaf {
+		case "":
+			if recursive {
+				return js(s.account())
+			}
+			return text("aliases\nemail\nidentity\nscopes\ntoken\n")
+		case "email":
+			return text(s.cfg.Email)
+		case "aliases":
+			return text("default\n")
+		case "scopes":
+			return text(strings.Join(s.cfg.Scopes, "\n") + "\n")
+		case "token":
+			// ?scopes= is accepted and ignored: the real token's scopes are
+			// the host's, and the route's rules are what bound its use.
+			return js(map[string]any{
+				"access_token": s.cfg.Placeholder,
+				"expires_in":   s.expiresIn(),
+				"token_type":   "Bearer",
+			})
+		case "identity":
+			// An ID token is a signed JWT for an audience: no placeholder can
+			// stand in for one without a route on the audience's host.
+			http.Error(w, "identity tokens are not served", http.StatusNotFound)
+			return http.StatusNotFound
+		}
+	}
+	http.NotFound(w, r)
+	return http.StatusNotFound
+}
+
+func (s *Server) account() map[string]any {
+	return map[string]any{"aliases": []string{"default"}, "email": s.cfg.Email, "scopes": s.cfg.Scopes}
+}
+
+// expiresIn follows the real token's expiry where the source knows it, so a
+// client asks again when the host's token turns over; the placeholder itself
+// never changes.
+func (s *Server) expiresIn() int {
+	const hour = 3599
+	if s.cfg.Credential == nil {
+		return hour
+	}
+	sec, err := s.cfg.Credential.Get()
+	if err != nil || sec.Expires.IsZero() {
+		return hour
+	}
+	n := int(sec.Expires.Sub(s.cfg.Now()).Seconds())
+	return max(0, min(n, hour))
+}
+
+func (c Config) String() string { return fmt.Sprintf("metadata{%s %s}", c.ProjectID, c.Email) }
+
+type doneConn struct {
+	net.Conn
+	done chan struct{}
+	once sync.Once
+}
+
+func (c *doneConn) Close() error {
+	var err error
+	c.once.Do(func() { err = c.Conn.Close(); close(c.done) })
+	return err
+}
+
+type chanListener struct {
+	ch     chan net.Conn
+	closed chan struct{}
+}
+
+func (l *chanListener) Accept() (net.Conn, error) {
+	select {
+	case c := <-l.ch:
+		return c, nil
+	case <-l.closed:
+		return nil, net.ErrClosed
+	}
+}
+func (l *chanListener) Close() error   { return nil }
+func (l *chanListener) Addr() net.Addr { return &net.TCPAddr{} }
