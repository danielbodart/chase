--- /dev/null
+++ b/internal/metadata/token_test.go
@@ -0,0 +1,180 @@
+package metadata
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"golang.org/x/oauth2"
+	"golang.org/x/oauth2/google"
+
+	"github.com/danielbodart/frisket/internal/credential"
+	"github.com/danielbodart/frisket/internal/intercept"
+	"github.com/danielbodart/frisket/internal/steer"
+)
+
+// Design (b): the sandbox holds a placeholder authorized_user file. x/oauth2
+// POSTs the placeholder refresh token to the real oauth2.googleapis.com/token;
+// frisket answers it without dialling anything, and the API call's
+// placeholder becomes the real token on *.googleapis.com.
+func TestSpikeTokenEndpointThenAPI(t *testing.T) {
+	log := &buf{}
+	logger := slog.New(slog.NewJSONHandler(log, nil))
+
+	var mu sync.Mutex
+	var seen []string
+	uca, _ := intercept.NewCA([]string{"*.googleapis.com"})
+	up := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seen = append(seen, r.Host+" "+r.URL.Path+" "+r.Header.Get("Authorization"))
+		mu.Unlock()
+		_, _ = io.WriteString(w, `{"items":[]}`)
+	}))
+	up.EnableHTTP2 = true
+	up.TLS = &tls.Config{GetCertificate: func(h *tls.ClientHelloInfo) (*tls.Certificate, error) { return uca.Leaf(h.ServerName) }}
+	up.StartTLS()
+	t.Cleanup(up.Close)
+	upPool := x509.NewCertPool()
+	upPool.AddCert(uca.Certificate())
+	_, upPort, _ := net.SplitHostPort(up.Listener.Addr().String())
+
+	tokPath := filepath.Join(t.TempDir(), "gcp-token")
+	if err := os.WriteFile(tokPath, []byte(realToken+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cred, err := credential.WatchFile(tokPath, credential.Trimmed(), logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cred.Close() })
+
+	var dmu sync.Mutex
+	var dialled []string
+	ic, err := intercept.New(intercept.Config{
+		Routes: []intercept.Route{
+			{
+				Name: "google-token", Host: "oauth2.googleapis.com", Upstream: "https://oauth2.googleapis.com",
+				Scope:  intercept.Scope{Paths: []intercept.PathRule{{Methods: []string{"POST"}, Prefix: "/token"}}},
+				Answer: TokenEndpoint(placeholder, 3599),
+			},
+			{
+				Name: "google", Host: "*.googleapis.com", Upstream: "https://*.googleapis.com:" + upPort,
+				UpstreamCAs: upPool, Credential: cred, Inject: intercept.Bearer(), Placeholder: placeholder,
+				Scope: intercept.Scope{Paths: []intercept.PathRule{{Methods: []string{"GET"}, Prefix: "/"}}},
+			},
+		},
+		Log: logger, Policy: "p",
+		DialContext: func(ctx context.Context, n, a string) (net.Conn, error) {
+			dmu.Lock()
+			dialled = append(dialled, a)
+			dmu.Unlock()
+			return (&net.Dialer{}).DialContext(ctx, n, up.Listener.Addr().String())
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ic.Close() })
+	ca, err := intercept.NewCA(ic.Hosts())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("CA constrained to %q", ca.Hosts())
+	addr := listenAs(t, log, netip.AddrPortFrom(service, 443), ic.For(ca, "/w"))
+
+	roots := x509.NewCertPool()
+	roots.AddCert(ca.Certificate())
+	hc := &http.Client{Transport: &http.Transport{
+		TLSClientConfig:   &tls.Config{RootCAs: roots},
+		ForceAttemptHTTP2: true,
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "tcp", addr)
+		},
+	}}
+	ctx := context.WithValue(context.Background(), oauth2.HTTPClient, hc)
+
+	// What `gcloud auth application-default login` writes, with placeholders.
+	adc := `{"type":"authorized_user","client_id":"proxy-injected.apps.googleusercontent.com","client_secret":"proxy-injected","refresh_token":"proxy-injected","quota_project_id":"my-project"}`
+	creds, err := google.CredentialsFromJSON(ctx, []byte(adc), "https://www.googleapis.com/auth/cloud-platform")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tok, err := creds.TokenSource.Token()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("x/oauth2 got access_token=%q type=%q expiry in %v", tok.AccessToken, tok.TokenType, tok.Expiry.Sub(tok.Expiry.Add(0)))
+	if tok.AccessToken != placeholder {
+		t.Fatalf("token %q", tok.AccessToken)
+	}
+
+	api := oauth2.NewClient(ctx, creds.TokenSource)
+	for _, u := range []string{"https://storage.googleapis.com/storage/v1/b?project=my-project", "https://bigquery.googleapis.com/bigquery/v2/projects/my-project/datasets"} {
+		res, err := api.Get(u)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, _ := io.ReadAll(res.Body)
+		res.Body.Close()
+		if res.StatusCode != 200 {
+			t.Fatalf("%s: %d %s", u, res.StatusCode, body)
+		}
+	}
+
+	// A refresh token that is not the placeholder is answered, never forwarded.
+	res, err := hc.PostForm("https://oauth2.googleapis.com/token", map[string][]string{"grant_type": {"refresh_token"}, "refresh_token": {"1//real-looking"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(res.Body)
+	res.Body.Close()
+	t.Logf("other refresh token: %d %s", res.StatusCode, strings.TrimSpace(string(body)))
+	if res.StatusCode != 400 {
+		t.Fatalf("got %d", res.StatusCode)
+	}
+	// Out of the token route's scope: refused before the handler.
+	res, err = hc.Get("https://oauth2.googleapis.com/tokeninfo?access_token=x")
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	t.Logf("GET /tokeninfo: %d", res.StatusCode)
+
+	mu.Lock()
+	defer mu.Unlock()
+	dmu.Lock()
+	defer dmu.Unlock()
+	t.Logf("upstream saw: %q", seen)
+	t.Logf("frisket dialled: %q", dialled)
+	for _, s := range seen {
+		if !strings.HasSuffix(s, " Bearer "+realToken) || strings.HasPrefix(s, "oauth2.") {
+			t.Fatalf("upstream saw %q", s)
+		}
+	}
+	for _, d := range dialled {
+		if strings.HasPrefix(d, "oauth2.") {
+			t.Fatalf("dialled %s", d)
+		}
+	}
+	for _, l := range strings.Split(log.String(), "\n") {
+		if strings.Contains(l, `"msg":"request"`) {
+			t.Logf("log: %s", l)
+		}
+	}
+	if strings.Contains(log.String(), realToken) {
+		t.Fatal("the real token is in the log")
+	}
+}
+
+var _ steer.Handler = (*Server)(nil)
