+package metadata
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	gce "cloud.google.com/go/compute/metadata"
+
+	"github.com/danielbodart/frisket/internal/credential"
+	"github.com/danielbodart/frisket/internal/intercept"
+	"github.com/danielbodart/frisket/internal/serve"
+	"github.com/danielbodart/frisket/internal/steer"
+)
+
+const (
+	placeholder = "proxy-injected"
+	realToken   = "ya29.real-token"
+	suffix      = "googleapis.test"
+)
+
+var service = netip.MustParseAddr("192.0.2.2")
+
+type buf struct {
+	mu sync.Mutex
+	b  bytes.Buffer
+}
+
+func (b *buf) Write(p []byte) (int, error) { b.mu.Lock(); defer b.mu.Unlock(); return b.b.Write(p) }
+func (b *buf) String() string              { b.mu.Lock(); defer b.mu.Unlock(); return b.b.String() }
+
+// listenAs serves h on loopback as if every connection had been steered from
+// dst: what the kernel's TPROXY would say.
+func listenAs(t *testing.T, log io.Writer, dst netip.AddrPort, h steer.Handler) string {
+	t.Helper()
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Skip(err)
+	}
+	s := steer.New("sess", log)
+	s.Dst = func(*net.TCPConn) netip.AddrPort { return dst }
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	t.Cleanup(func() { cancel(); <-done })
+	go func() { defer close(done); _ = s.Serve(ctx, ln, h) }()
+	return ln.Addr().String()
+}
+
+// The whole loop: a Google client finds the metadata server by
+// GCE_METADATA_HOST, is handed the placeholder, sends it to a Google API host,
+// and the upstream sees the real token -- which the sandbox never did.
+func TestSpikeMetadataThenAPI(t *testing.T) {
+	log := &buf{}
+	logger := slog.New(slog.NewJSONHandler(log, nil))
+
+	var mu sync.Mutex
+	var seen []string
+	uca, _ := intercept.NewCA([]string{"*." + suffix})
+	up := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seen = append(seen, r.Host+" "+r.Header.Get("Authorization"))
+		mu.Unlock()
+		_, _ = io.WriteString(w, `{"items":[]}`)
+	}))
+	up.EnableHTTP2 = true
+	up.TLS = &tls.Config{GetCertificate: func(h *tls.ClientHelloInfo) (*tls.Certificate, error) { return uca.Leaf(h.ServerName) }}
+	up.StartTLS()
+	t.Cleanup(up.Close)
+	upPool := x509.NewCertPool()
+	upPool.AddCert(uca.Certificate())
+	_, upPort, _ := net.SplitHostPort(up.Listener.Addr().String())
+
+	dir := t.TempDir()
+	tokPath := filepath.Join(dir, "gcp.json")
+	exp := time.Now().Add(40 * time.Minute)
+	b, _ := json.Marshal(map[string]any{"access_token": realToken, "expires_ms": exp.UnixMilli()})
+	if err := os.WriteFile(tokPath, b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cred, err := credential.WatchFile(tokPath, credential.JSON{Token: "access_token", ExpiresMillis: "expires_ms"}.Extract, logger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cred.Close() })
+
+	ic, err := intercept.New(intercept.Config{
+		Routes: []intercept.Route{{
+			Name: "google", Host: "*." + suffix, Upstream: "https://*." + suffix + ":" + upPort,
+			UpstreamCAs: upPool, Credential: cred, Inject: intercept.Bearer(), Placeholder: placeholder,
+			Scope: intercept.Scope{Paths: []intercept.PathRule{{Methods: []string{"GET"}, Prefix: "/"}}},
+		}},
+		Log: logger, Policy: "p",
+		DialContext: func(ctx context.Context, n, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, n, up.Listener.Addr().String())
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ic.Close() })
+	ca, _ := intercept.NewCA(ic.Hosts())
+
+	md := New(Config{ProjectID: "my-project", NumericProjectID: "1234", Email: "agent@my-project.iam.gserviceaccount.com",
+		Placeholder: placeholder, Credential: cred, Log: logger})
+	t.Cleanup(func() { _ = md.Close() })
+
+	d := serve.Dispatch{Service: []netip.Addr{service}, Handlers: serve.Handlers{
+		Intercept: ic.For(ca, "/w"),
+		Metadata:  md,
+		Egress:    steer.HandlerFunc(func(_ context.Context, c *steer.Conn) { _ = c.Close(); t.Error("egress") }),
+	}}
+	addr80 := listenAs(t, log, netip.AddrPortFrom(service, 80), d)
+	addr443 := listenAs(t, log, netip.AddrPortFrom(service, 443), d)
+
+	// The sandbox's client: GCE_METADATA_HOST names the service address.
+	t.Setenv("GCE_METADATA_HOST", service.String())
+	mdc := gce.NewClient(&http.Client{Transport: &http.Transport{
+		DialContext: func(ctx context.Context, _, a string) (net.Conn, error) {
+			if a != service.String()+":80" {
+				t.Errorf("metadata client dialled %s", a)
+			}
+			return (&net.Dialer{}).DialContext(ctx, "tcp", addr80)
+		},
+	}})
+	ctx := context.Background()
+	if !mdc.OnGCEWithContext(ctx) {
+		t.Fatal("not on GCE")
+	}
+	pid, err := mdc.ProjectIDWithContext(ctx)
+	if err != nil || pid != "my-project" {
+		t.Fatalf("project: %q %v", pid, err)
+	}
+	email, err := mdc.EmailWithContext(ctx, "default")
+	if err != nil || email != "agent@my-project.iam.gserviceaccount.com" {
+		t.Fatalf("email: %q %v", email, err)
+	}
+	ud, err := mdc.GetWithContext(ctx, "universe/universe-domain")
+	if err != nil || ud != "googleapis.com" {
+		t.Fatalf("universe: %q %v", ud, err)
+	}
+	raw, err := mdc.GetWithContext(ctx, "instance/service-accounts/default/token?scopes=https://www.googleapis.com/auth/cloud-platform")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tok struct {
+		AccessToken string `json:"access_token"`
+		ExpiresIn   int    `json:"expires_in"`
+		TokenType   string `json:"token_type"`
+	}
+	if err := json.Unmarshal([]byte(raw), &tok); err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("token response: %s", strings.TrimSpace(raw))
+	if tok.AccessToken != placeholder || tok.ExpiresIn < 2390 || tok.ExpiresIn > 2400 {
+		t.Fatalf("token: %+v", tok)
+	}
+
+	// Without the header, GCE's answer.
+	req, _ := http.NewRequest("GET", "http://"+service.String()+"/computeMetadata/v1/project/project-id", nil)
+	res, err := (&http.Client{Transport: &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "tcp", addr80)
+	}}}).Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	if res.StatusCode != 403 {
+		t.Fatalf("no flavor: %d", res.StatusCode)
+	}
+
+	// The API call, with what the metadata server handed out.
+	roots := x509.NewCertPool()
+	roots.AddCert(ca.Certificate())
+	api := &http.Client{Transport: &http.Transport{
+		TLSClientConfig: &tls.Config{RootCAs: roots},
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "tcp", addr443)
+		},
+		ForceAttemptHTTP2: true,
+	}}
+	for _, h := range []string{"storage." + suffix, "bigquery." + suffix} {
+		req, _ = http.NewRequest("GET", "https://"+h+"/v1/projects/my-project", nil)
+		req.Header.Set("Authorization", tok.TokenType+" "+tok.AccessToken)
+		res, err = api.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, _ := io.ReadAll(res.Body)
+		res.Body.Close()
+		if res.StatusCode != 200 {
+			t.Fatalf("%s: %d %s", h, res.StatusCode, body)
+		}
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	for _, s := range seen {
+		if !strings.HasSuffix(s, " Bearer "+realToken) {
+			t.Fatalf("upstream saw %q", s)
+		}
+	}
+	t.Logf("upstream saw: %q", seen)
+	if strings.Contains(log.String(), realToken) {
+		t.Fatal("the real token is in the log")
+	}
+}
