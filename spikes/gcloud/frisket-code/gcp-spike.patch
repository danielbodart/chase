@@ -0,0 +1,50 @@
+package policy
+
+import (
+	"log/slog"
+	"net/netip"
+	"testing"
+
+	"github.com/danielbodart/frisket/internal/control"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+// SPIKE: a policy with a "*.googleapis.com" route builds, its DNS answers any
+// name below the suffix with the service address, and the session's CA is
+// constrained to the suffix.
+func TestSpikeAWildcardRouteBuilds(t *testing.T) {
+	p := valid(t)
+	p.Allow = []string{"*.googleapis.com", "api.test", "googleapis.com"}
+	p.Routes = append(p.Routes, Route{
+		Name: "google", Host: "*.googleapis.com", Upstream: "https://*.googleapis.com",
+		CredentialFile: p.Routes[0].CredentialFile, Placeholder: "proxy-injected",
+		Paths: []PathRule{{Methods: []string{"GET", "POST"}, Prefix: "/"}},
+	})
+	up := &counting{}
+	pol := open(t, up, "p", p)
+	svc := []netip.Addr{netip.MustParseAddr("192.0.2.2")}
+	h, err := pol.Handlers(control.Session{Name: "s", Policy: "/p.json", Service: svc}, nil, slog.New(slog.NewJSONHandler(&journal{}, nil)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, n := range []string{"storage.googleapis.com.", "us-central1-aiplatform.googleapis.com.", "a.b.googleapis.com."} {
+		m := ask(t, h, n)
+		if len(m.Answers) != 1 || m.Answers[0].Body.(*dnsmessage.AResource).A != [4]byte{192, 0, 2, 2} {
+			t.Errorf("%s answered %+v, want the service address", n, m.Answers)
+		}
+	}
+	// The suffix itself is allowed, not intercepted: resolved upstream.
+	_ = ask(t, h, "googleapis.com.")
+	up.mu.Lock()
+	t.Logf("asked upstream: %q", up.asked)
+	up.mu.Unlock()
+
+	// A wildcard route with an allowlist that does not cover every name below
+	// it is refused.
+	p.Allow = []string{"storage.googleapis.com", "api.test"}
+	if err := check(t, "p2", p); err == nil {
+		t.Fatal("a wildcard route under an exact allow was accepted")
+	} else {
+		t.Logf("refused: %v", err)
+	}
+}
