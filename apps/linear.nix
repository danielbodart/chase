# Linear's API -- GraphQL, and nothing else, at api.linear.app -- and a CLI
# that speaks it, where the consumer gives one: nixpkgs has none.
{ config, options, lib, pkgs, ... }:

let
  inherit (lib) mkEnableOption mkIf mkOption types;
  cfg = config.chase;
  ops = import ../lib/operations.nix { inherit lib; };
  apps = import ../lib/apps.nix { inherit lib; };
  machine = options.chase.apps.linear;
  host = "api.linear.app";

  # EVERY MUTATION IN LINEAR'S OWN GRAPHQL SCHEMA, one rule each: a write, or
  # guarded where its name's last word is Delete or ./linear/exceptions.json
  # says so -- a secret rotated, a webhook, an integration, the workspace and
  # who has access to it. A query is a read. Generated by chase-generate
  # operations (../internal/generate) from a pinned commit of the schema
  # Linear's SDK is built from. Each mutation's category is the first word
  # of its name: issue, comment, project. See ../docs/linear.md.
  operations = builtins.fromJSON (builtins.readFile ./linear/operations.json);

  # A GraphQL error, which a client prints: it then says why a request was
  # refused, rather than only that it failed.
  refusal = {
    contentType = "application/json";
    body = builtins.toJSON { errors = [ { message = "{{message}}"; } ]; };
  };
in
{
  options.chase.apps.linear = {
    package = mkOption {
      type = types.nullOr types.package;
      default = null;
      example = lib.literalExpression "inputs.linear-cli.packages.\${system}.default";
      description = ''
        The Linear CLI an authenticated session gets, or null for none: the
        API is still there, to an SDK or curl. nixpkgs has no Linear CLI, so
        there is no default.
      '';
    };
    credentialFile = mkOption {
      type = types.nullOr types.path;
      default = null;
      example = "/run/secrets/linear-work-token";
      description = ''
        A file holding a Linear personal API key, alone. frisket reads it on
        the host and puts it in an authenticated session's requests to
        ${host}, bare in `Authorization` (frisket's `bare`), as Linear takes a personal key;
        nothing inside a container ever sees it. One key is one workspace,
        so a tier usually binds its own.
      '';
    };
  };

  options.chase.tiers = mkOption {
    type = types.attrsOf (types.submodule ({ config, ... }: {
      options.apps.linear = ops.appOptions config // apps.overrides machine [ "package" "credentialFile" ] // {
        enable = mkEnableOption ''
          Linear's API in this tier: a query goes straight through, with no
          credential and no CLI, unless it is `authenticated`'';
        authenticated = mkEnableOption ''
          Linear's API with the credential, and the CLI: a query goes
          straight through, and each mutation, by its field, is answered as
          `writes`, `guarded` and `unmatched` say'';
      };
    }));
  };

  config = {
    assertions = apps.credentialAssertions cfg.tiers "linear";

    containers = lib.mapAttrs' (name: tier: lib.nameValuePair "chase-${name}" (mkIf (tier.apps.linear.enable && tier.apps.linear.authenticated) {
      config = {
        environment.systemPackages = lib.optional (tier.apps.linear.package != null) tier.apps.linear.package;
        # What the CLI, and Linear's SDK, read a key from, ahead of any
        # keyring or file: there is none in a session.
        environment.variables.LINEAR_API_KEY = cfg.placeholder;
        # Otherwise the CLI takes LINEAR_API_KEY from a checkout's .env
        # first, and the session would send a key of the checkout's, not
        # the placeholder frisket swaps for the tier's.
        environment.variables.LINEAR_IGNORE_ENV_FILE = "1";
      };
    })) cfg.tiers;

    chase.internal.policies = lib.mapAttrs (name: tier: mkIf tier.apps.linear.enable (
      let s = ops.mark tier (ops.settings tier.apps.linear); in
      {
        # For a tier with an allowlist of names; one allowing `*` has it already.
        allow.${host} = true;
        # Not authenticated, intercepted with no credential, so the scope
        # holds: a key the session brings still reaches Linear, but only to
        # read.
        routes.linear = ops.route s operations // {
          inherit host refusal;
          upstream = "https://${host}";
        } // lib.optionalAttrs tier.apps.linear.authenticated {
          credentialFile = tier.apps.linear.credentialFile;
          placeholder = cfg.placeholder;
          bare = true;
        };
      })) cfg.tiers;
  };
}
